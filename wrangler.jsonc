{
  // Configuration Cloudflare Workers : le Worker sert les fichiers statiques produits par « npm run build ».
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopper-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
